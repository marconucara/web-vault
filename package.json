{
  "name": "web-vault",
  "version": "0.12.0",
  "description": "A static web viewer/editor for Markdown knowledge vaults. Strongly inspired by and compatible with Tolaria vaults.",
  "type": "module",
  "bin": {
    "wv": "bin/wv.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "roundtrip:spike": "node scripts/roundtrip-spike.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "verify": "yarn typecheck && yarn test"
  },
  "exports": {
    "./functions/commit.js": "./functions/commit.js",
    "./functions/worker.js": "./functions/worker.js",
    "./vite-config": "./lib/vite-config.mjs"
  },
  "files": [
    "bin",
    "brand",
    "lib",
    "src",
    "scripts",
    "functions",
    "index.html"
  ],
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/view": "^6.43.7",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^4.3.4",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^26.3.6",
    "js-yaml": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.11",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "vite": "^5.4.11"
  },
  "packageManager": "yarn@4.5.3+sha512.3003a14012e2987072d244c720506549c1aab73ee728208f1b2580a9fd67b92d61ba6b08fe93f6dce68fd771e3af1e59a0afa28dd242dd0940d73b95fedd4e90",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^24.1.3",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
